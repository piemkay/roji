#!/usr/bin/env bash
# No secrets in the repository. Fails when gitleaks finds a secret in a commit of the current
# branch that is not on the main branch yet (all of the branch's history when it is main), or
# in the files not committed yet (tracked or untracked, but not ignored), or when an environment
# file such as .env is tracked. Other local branches are not scanned.
#
# The main branch is ROJI_BASE_REF, else origin/$GITHUB_BASE_REF in a pull request, else
# origin/main, else main.
#
# gitleaks is downloaded once into ~/.cache/roji and checked against a pinned SHA-256.
set -euo pipefail
shopt -s inherit_errexit # a failing command inside $(...) stops the script too

root=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)
cd "$root"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/roji"

GITLEAKS_VERSION=8.30.1

die() {
  printf 'check-secrets: %s\n' "$*" >&2
  exit 1
}

# Runs in a subshell (see gitleaks_bin), so download_tmp and the trap end with it.
download_gitleaks() {
  local arch=$1 sha=$2 dir=$3
  local file="gitleaks_${GITLEAKS_VERSION}_$arch.tar.gz"
  mkdir -p "$cache_dir"
  download_tmp=$(mktemp -d "$cache_dir/download.XXXXXX")
  trap 'rm -rf "$download_tmp"' EXIT
  curl -fsSL --retry 3 -o "$download_tmp/$file" \
    "https://github.com/gitleaks/gitleaks/releases/download/v$GITLEAKS_VERSION/$file"
  printf '%s  %s\n' "$sha" "$download_tmp/$file" | sha256sum --check --quiet ||
    die "checksum mismatch for $file"
  mkdir "$download_tmp/gitleaks"
  tar -xzf "$download_tmp/$file" -C "$download_tmp/gitleaks" gitleaks
  mv -T "$download_tmp/gitleaks" "$dir" 2>/dev/null || [[ -x $dir/gitleaks ]] ||
    die "cannot install into $dir"
}

gitleaks_bin() {
  local arch sha
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64)
      arch=linux_x64
      sha=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
      ;;
    Linux-aarch64 | Linux-arm64)
      arch=linux_arm64
      sha=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
      ;;
    *) die "no pinned gitleaks download for $(uname -s) $(uname -m)" ;;
  esac
  local dir="$cache_dir/gitleaks-$GITLEAKS_VERSION-$arch"
  if [[ ! -x $dir/gitleaks ]]; then
    (download_gitleaks "$arch" "$sha" "$dir")
  fi
  printf '%s\n' "$dir/gitleaks"
}

# The commits to scan: those of the current branch that are not on the main branch.
commit_range() {
  local ref base refs=()
  [[ -n ${ROJI_BASE_REF:-} ]] && refs+=("$ROJI_BASE_REF")
  refs+=("origin/${GITHUB_BASE_REF:-main}" main)
  for ref in "${refs[@]}"; do
    if git rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
      base=$(git merge-base "$ref" HEAD) || continue
      if [[ $base != "$(git rev-parse HEAD)" ]]; then
        printf '%s..HEAD\n' "$base"
        return
      fi
      break
    fi
  done
  # On the main branch itself, or with no main branch: the whole history of HEAD.
  printf 'HEAD\n'
}

env_files=$(git ls-files | grep -E '(^|/)\.env(\.[^/]*)?$' || true)
if [[ -n $env_files ]]; then
  die "environment files must not be committed: $env_files"
fi

gitleaks=$(gitleaks_bin)

range=$(commit_range)
echo "Scanning commits $range and the working tree."
"$gitleaks" git --no-banner --redact --verbose --log-level warn --log-opts="$range" .

# The working tree as it would be committed: tracked and untracked files, without ignored ones.
snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT
git ls-files -z --cached --others --exclude-standard |
  tar --null --files-from=- --ignore-failed-read -cf - 2>/dev/null |
  tar -xf - -C "$snapshot"
"$gitleaks" dir --no-banner --redact --verbose --log-level warn "$snapshot"

echo "No secrets found."

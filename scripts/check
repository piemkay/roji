#!/usr/bin/env bash
# The one check, run by CI on every pull request. While the project is in planning there is no
# code, so it only makes sure no secret is committed and that the scan itself still works.
set -euo pipefail

root=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)
cd "$root"

step() { printf '\n==> %s\n' "$*"; }

step "No secrets in the repository"
scripts/check-secrets

step "Tests of the scripts"
for test in scripts/tests/*.sh; do
  bash "$test"
done

step "All checks passed"
